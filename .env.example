# Copy to .env for local development. Synthetic data only.
NODE_ENV=development

# PostgreSQL 16 (native cluster via scripts/db.sh, or docker-compose.yml)
DB_PORT=54329
DATABASE_URL=postgresql://carepath:carepath@127.0.0.1:54329/carepath

# API
API_HOST=127.0.0.1
API_PORT=4000
# "loopback" when the API sits behind the same-host Next.js /api rewrite, so rate limits see
# the browser's address from X-Forwarded-For. "off" trusts no proxy.
TRUST_PROXY=off

# Web
WEB_PORT=3000
# The browser talks only to the web origin; Next.js rewrites /api/* to the API (checkpoint C1, 5.2).

# Session cookie signing/secret (replace for any shared environment)
SESSION_SECRET=change-me-dev-only

# AI provider: "deterministic" (default, rule-based demo output) or "anthropic"
AI_PROVIDER=deterministic
# Only used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Serverless deployment (docs/deployment.md). Leave unset for local development.
# Bearer secret for GET /internal/cron/jobs (Vercel Cron sends it). At least 16 characters in production.
CRON_SECRET=
# Time budget for one cron pass, in milliseconds.
CRON_BUDGET_MS=45000
# 1: deliver a sent or retried message inside the same request (no worker loop on a function).
JOBS_INLINE=0
