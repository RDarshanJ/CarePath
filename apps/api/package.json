{
  "name": "@carepath/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm --filter @carepath/db migrate:deploy && vitest run",
    "jobs:drain": "tsx src/core/jobs/drain.ts",
    "openapi:check": "tsx scripts/openapi.ts check",
    "openapi:write": "tsx scripts/openapi.ts write"
  },
  "dependencies": {
    "@carepath/ai": "workspace:*",
    "@carepath/db": "workspace:*",
    "@carepath/fhir": "workspace:*",
    "@carepath/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.5",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@carepath/config": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
