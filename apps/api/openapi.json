            "description": "End of the session if no request arrives first (30 minutes idle)."
          }
        },
        "required": [
          "user",
          "organization",
          "role",
          "permissions",
          "patientId",
          "practitionerId",
          "csrfToken",
          "expiresAt",
          "idleExpiresAt"
        ]
