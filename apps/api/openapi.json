{
  "openapi": "3.1.0",
  "info": {
    "title": "CarePath API",
    "version": "0.1.0",
    "description": "Demonstration product. Synthetic data. Not for clinical use. Session cookie auth; mutating requests need an allowed Origin and the x-csrf-token header."
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session"
      }
    },
    "schemas": {
      "ErrorEnvelopeInput": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "validation_error",
                  "organization_required",
                  "invalid_credentials",
                  "unauthenticated",
                  "session_expired",
                  "origin_rejected",
                  "csrf_failed",
                  "forbidden",
                  "not_on_care_team",
                  "not_found",
                  "conflict",
                  "payload_too_large",
                  "unsupported_media_type",
                  "rate_limited",
                  "internal_error",
                  "service_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "Dot path of the offending field, empty for the whole input."
                    },
                    "issue": {
                      "type": "string",
                      "description": "Machine-readable issue code."
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "issue",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginRequestInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "organizationSlug": {
            "description": "Needed only when the account belongs to more than one organization.",
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "SessionInfoInput": {
        "type": "object",
